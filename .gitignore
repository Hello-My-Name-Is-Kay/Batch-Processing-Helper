# Runtime data (auto-created inside project)
.batch-data/
.batch-data/**
!.batch-data/.gitkeep
!.batch-data/history/.gitkeep

# Legacy top-level runtime dirs (kept for compatibility)
/requests/
/responses/
/completed/
/escalations/
/logs/
!/requests/.gitkeep
!/responses/.gitkeep
!/completed/.gitkeep
!/escalations/.gitkeep
!/logs/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
.env
.env.local

# Runtime state (ephemeral)
*.pid
*.lock
