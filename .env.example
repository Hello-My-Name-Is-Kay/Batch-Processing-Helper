# Copy to .env (git-ignored) and fill in what you need:  cp .env.example .env
#
# batch-config.sh loads this file, so cron jobs and other non-interactive
# callers see your keys even though they do not inherit your shell's exports.
# Plain KEY=VALUE lines only: no inline comments, no variable expansion.
# Values already set in the environment take precedence over this file.
# Keep it private:  chmod 600 .env

# --- Provider: anthropic (default) or openrouter ---
# BATCH_PROVIDER=anthropic

# --- API keys (set the one for your provider) ---
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# --- Models (all optional; leave unset for the provider defaults) ---
# BATCH_MODEL=
# OPENROUTER_BATCH_MODEL=
# ROUTER_MODEL=
# OPENROUTER_ROUTER_MODEL=

# --- Polling: seconds, applied by "batch-orchestrator.sh setup-cron" ---
# BATCH_POLL_INTERVAL=120
